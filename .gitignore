# Visual Studio .NET gitignore

## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Build Folders
[Bb]in/
[Oo]bj/

# Visual Studio
.vs/
*.user
*.suo

# Rider
.idea/

# Visual Studio Code
.vscode/

# DotNet
*.db
*.log

# Local environment
.env
.env.*

# User-specific files
*.userosscache
*.sln.docstates

# OS files
Thumbs.db
.DS_Store
